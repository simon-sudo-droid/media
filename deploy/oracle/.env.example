# Production environment for the Oracle Cloud VM.
# Copy to `.env` ON THE VM and fill in. Never commit the real .env.
#
#   cp .env.example .env && nano .env
#
# NOTE: this file is read by docker-compose.prod.yml (env_file) and supplies
# both the API container's settings and Caddy's $API_DOMAIN.

# ── Hostname for the API (must resolve to this VM's public IP) ────
# Caddy requests a Let's Encrypt certificate for exactly this name.
API_DOMAIN=api.example.com

# ── Database — Supabase session pooler (port 5432) ───────────────
# Supabase ▸ Project ▸ Connect ▸ Session pooler. The app appends
# sslmode=require automatically for Supabase hosts.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Reuse the CURRENT production secret to keep everyone logged in through the
# migration; use a fresh one only if you accept that all sessions reset.
JWT_SECRET=

# Production safety: leave false. The app refuses to boot with the default
# dev JWT secret unless DEBUG=true.
DEBUG=false

# ── Public URLs ──────────────────────────────────────────────────
# Comma-separated browser origins allowed by CORS. Keep BOTH the new and old
# frontends listed during cutover, then trim.
CORS_ORIGINS=https://your-app.vercel.app
# Used to build password-reset links.
FRONTEND_URL=https://your-app.vercel.app

# ── AI providers (optional — defaults to deterministic mock output) ──
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Admins (comma-separated) ─────────────────────────────────────
ADMIN_EMAILS=simongodlisten10@gmail.com,jeerameljoy@ataandeadvisors.com

# ── Optional SMTP for real password-reset emails ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
