# ─────────────────────────────────────────────────────────────
# EditMentor AI — environment configuration
# Copy this file to `.env` and fill in values. Everything has a
# working default for local dev, so the app runs WITHOUT any keys.
# ─────────────────────────────────────────────────────────────

# ── Database (local Postgres via Docker) ─────────────────────
POSTGRES_USER=editmentor
POSTGRES_PASSWORD=editmentor
POSTGRES_DB=editmentor
# When moving to Supabase, set DATABASE_URL to the Supabase
# connection string (the api service reads this directly):
# DATABASE_URL=postgresql+psycopg://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Local development flag. Allows the default JWT secret and returns the reset
# link in the API response for testing. In production leave this false/unset:
# the app then rejects the default JWT secret and never exposes reset links.
DEBUG=true

# ── Auth (JWT — local fallback, no external service needed) ──
# Generate a strong secret for production:  openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# To switch to Clerk later, set these and flip AUTH_PROVIDER=clerk
AUTH_PROVIDER=local            # local | clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ── AI providers (optional — falls back to mock responses) ───
# When empty, the AI endpoints return high-quality canned output
# so every feature is demoable with zero spend.
AI_PROVIDER=mock               # mock | openai | claude | gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-fable-5
GEMINI_MODEL=gemini-2.0-flash
# Text-to-video for "Generate sample clip" (needs a paid Veo-enabled key;
# otherwise falls back to a storyboard preview).
VEO_MODEL=veo-3.0-generate-preview

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
